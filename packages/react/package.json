{
  "name": "@handset/react",
  "version": "0.1.0",
  "description": "Headless React hooks for building messaging UI on the Handset API. Powers Handset UI (https://github.com/handset-hq/handset-ui).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/handset-hq/handset-ui.git",
    "directory": "packages/react"
  },
  "homepage": "https://ui.handset.dev",
  "keywords": ["handset", "sms", "messaging", "react", "hooks", "telecom"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
