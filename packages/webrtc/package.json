{
  "name": "@handset/webrtc",
  "version": "0.1.0",
  "description": "Browser softphone for the Handset API: a carrier-neutral wrapper with token-based auth, plus a React hook. Powers Handset UI's dialer and call components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/handset-hq/handset-ui.git",
    "directory": "packages/webrtc"
  },
  "homepage": "https://ui.handset.dev",
  "keywords": ["handset", "webrtc", "softphone", "voice", "telecom", "react"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/react.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@telnyx/webrtc": "^2.22.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
